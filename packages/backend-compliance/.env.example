# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ─── Solana ───────────────────────────────────────────────────────────────────
# RPC endpoint — use devnet for local development
SOLANA_RPC_URL=https://api.devnet.solana.com

# delta-mint program ID — v3 unified market.
# (Legacy v1 was 13Su8nR5NBzQ7UwFFUiNAH1zH5DQtLyjezhbwRREQkEn; do not use.)
DELTA_MINT_PROGRAM_ID=BKprvLqNUDCGrpxddppHHQ3UBhof8J5axyexDyctX1xy

# governor program ID — v3 unified market.
# (Legacy v1 was BrZYcbPBt9nW4b6xUSodwXRfAfRNZTCzthp1ywMG3KJh; do not use.)
GOVERNOR_PROGRAM_ID=6xqW3D1ebp5WjbYh4vwar7ponxrpEaQiVG6uhBYVZtJi

# Comma-separated wrapped mint addresses — one per pool the institutional
# stack actually uses. One KYC approval whitelists the wallet on every
# pool listed here. v3 devnet inventory:
#   csSOL      = 6qpu7yCkdKF2D8vnySUNQEQczo5tYGRxbVFfdd8S5Nxt
#   csSOL-WT   = 8vmVcN9krv8edY8GY75hMLvkSSjANjkmYeZUux2a4Sva
#   ceUSX      = 8Uy7rmtAZvnQA1SuYZJKKBXFovHDPEYXiYH3H6iQMRwT
#   ceUSX-WT   = DoHMuKFU4b2co2CBBcNjVzWf6yL3KG5H2N9FxkfFFN6A
#   cSOL       = AX66E5UvhdndwBfdebrW2YeGbsQhRndsPfNWGd16xBhf
WRAPPED_MINT_ADDRESSES=6qpu7yCkdKF2D8vnySUNQEQczo5tYGRxbVFfdd8S5Nxt,8vmVcN9krv8edY8GY75hMLvkSSjANjkmYeZUux2a4Sva,8Uy7rmtAZvnQA1SuYZJKKBXFovHDPEYXiYH3H6iQMRwT,DoHMuKFU4b2co2CBBcNjVzWf6yL3KG5H2N9FxkfFFN6A,AX66E5UvhdndwBfdebrW2YeGbsQhRndsPfNWGd16xBhf

# Admin keypair as a JSON byte array — this keypair is the `authority`
# that signed initialize_mint, so it has permission to call add_to_whitelist.
#
# Generate:  solana-keygen new --outfile admin-keypair.json
# Read key:  cat admin-keypair.json
#
# NEVER commit a real keypair. Fund this keypair on devnet:
#   solana airdrop 2 <pubkey> --url devnet
ADMIN_KEYPAIR_JSON=[12,34,56,...]

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ─── Risk Controls ────────────────────────────────────────────────────────────
# Per-wallet maximum deposit exposure in USD
DEPOSIT_CAP_USD=1000000
# Total pool exposure cap in USD
POOL_CAP_USD=50000000
# Comma-separated mock OFAC/sanctions addresses (blocked at approve time)
OFAC_MOCK_LIST=

# ─── Microsoft Entra B2C ──────────────────────────────────────────────────────
# Set to true to skip JWT signature verification (local dev / CI only)
# When true and token is not a valid JWT, returns mock VaultAdmin claims
# NEVER set to true in production
ENTRA_MOCK=false
#
# Set up a free Azure B2C tenant at: https://portal.azure.com
# Guide: https://learn.microsoft.com/en-us/azure/active-directory-b2c/tutorial-create-tenant
#
# ENTRA_TENANT_NAME  — the subdomain of your .onmicrosoft.com domain
#                      e.g. for "mybank.onmicrosoft.com" use "mybank"
ENTRA_TENANT_NAME=
# ENTRA_TENANT_ID    — the Directory (tenant) ID GUID from Azure portal → Overview
ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID    — the Application (client) ID from your App Registration
ENTRA_CLIENT_ID=
# ENTRA_POLICY       — the B2C user flow name (created in Azure portal → User flows)
#                      Recommended flow type: Sign up and sign in (B2C_1_*)
ENTRA_POLICY=B2C_1_signupsignin
# "b2c" for classic Azure AD B2C tenants (default)
# "external" for new Entra External ID tenants created after May 2025
ENTRA_FLAVOR=b2c

# ─── Fireblocks (optional) ────────────────────────────────────────────────────
# Leave blank to use the local admin keypair (ADMIN_KEYPAIR_JSON).
# Set all three to enable Fireblocks MPC signing.
FIREBLOCKS_API_KEY=
FIREBLOCKS_VAULT_ACCOUNT_ID=0
FIREBLOCKS_SIGNER_PUBLIC_KEY=
