# Solstice API key (shared devnet key — do NOT commit the actual value).
# Forwarded by the panel's `callSolsticeRaw` as the `x-api-key` header to
# whichever proxy URL is reachable (edge → vite → direct).
VITE_SOLSTICE_API_KEY=

# backend-edge Worker base URL. The `/solstice` route on this Worker
# proxies to instructions.solstice.finance — replaces the legacy
# `_redirects`-based external rewrite (which trips Cloudflare Pages'
# "Failed to publish your Function" bug on monorepo deploys).
#
# Local dev: leave blank — the Vite proxy in vite.config.ts handles
# `/api/solstice` as a fallback. Production / preview: set to
#   VITE_EDGE_URL=https://clearstone-backend-edge.achim-d87.workers.dev
VITE_EDGE_URL=
