# Solstice API key (shared devnet key — do NOT commit the actual value)
VITE_SOLSTICE_API_KEY=

# backend-edge worker URL. Powers Term Deposits' market list,
# user-position aggregation, and the curator-vault NAV/allocations
# views. Unset → useFixedYieldMarkets / usePtPositions fall back to
# fixture data. Local dev:
#
#   VITE_EDGE_URL=http://localhost:8787
#
# Production:
#
#   VITE_EDGE_URL=https://clearstone-backend-edge.achim-d87.workers.dev
VITE_EDGE_URL=

# backend-compliance / KYC granting endpoint. Defaults to the same
# worker as VITE_EDGE_URL when unset (most deploys colocate them).
VITE_COMPLIANCE_API=
