# Address Lookup Tables (created by packages/programs/scripts/init-*-lut.ts)
VITE_DEPOSIT_LUT=
VITE_CREDIT_TRADE_LUT=
# LUT for the bundled USDC↔ceUSX flows on the eUSX panel — created by
# `npx tsx scripts/init-usx-flow-lut.ts` from packages/programs.
VITE_USX_FLOW_LUT=

# csSOL withdraw-ticket addresses (output of setup-cssol-wt-*.ts scripts)
VITE_CSSOL_WT_MINT=
VITE_POOL_PENDING_WSOL_ACCOUNT=
VITE_CSSOL_WT_RESERVE=

# Margin-pair (EG-3 / EG-4) addresses — see docs/operations/MARGIN_PAIR.md.
# Stage D' output: cSOL klend reserve registration. The USD side of the
# margin pair reuses the existing sUSDC reserve already in EG-1, so no
# separate wrap is needed.
VITE_CSOL_RESERVE=

# Solstice API key (shared devnet key — do NOT commit the actual value).
# Used by the ceUSX/sUSDC credit-trade panel for the USDC↔USX↔eUSX legs
# (RequestMint / ConfirmMint / Lock / Unlock / RequestRedeem /
# ConfirmRedeem). Mirrors frontend-institutional/.env.example.
VITE_SOLSTICE_API_KEY=
